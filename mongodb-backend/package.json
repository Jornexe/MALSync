{
  "name": "malsync-mongodb-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Thin HTTP API in front of MongoDB that lets the MALSync extension store sync entries. Mirrors the surface of the SpaceTimeDB reducers but speaks plain HTTP.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "create-key": "tsx src/scripts/create-key.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "@types/node": "^22.10.2"
  }
}
