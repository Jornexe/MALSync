MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=malsync
PORT=8787
# Optional. If set, only API keys whose hash matches a row in apiKeys are accepted.
# When unset and ALLOW_ANON=1, a single "anonymous" owner is used (localhost dev only).
ALLOW_ANON=0

# --- MangaDex import (npm run import-mangadex) -----------------------------
# Personal client credentials from https://mangadex.org/settings -> API Clients,
# plus your MangaDex account login (required for the OAuth2 password grant).
MANGADEX_CLIENT_ID=personal-client-xxxxxxxx
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=
# Defaults for the import target (overridable with --owner / --user flags).
MANGADEX_OWNER=anonymous
MANGADEX_USERKEY=
